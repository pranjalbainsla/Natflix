# Firebase (from Firebase Console → Project settings → Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Movie API (Cloud Run)
VITE_API_BASE_URL=

# Firebase App Check — reCAPTCHA v3 site key (Firebase Console → App Check)
# Optional for local dev; use FIREBASE_APPCHECK_DEBUG_TOKEN in the browser console instead.
VITE_RECAPTCHA_SITE_KEY=
